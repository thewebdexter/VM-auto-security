# TWDxOSOptimisation — fail2ban jail.local (RHEL/Fedora/CentOS family) v2.0.0
# https://github.com/TheWebDexterTech/TWDxOSOptimisation
#
# Requires `fail2ban` (EPEL on RHEL/CentOS/Rocky/Alma; native on Fedora).
#
# DEFAULT CHANGED in v2.0.0: ignoreip is LOOPBACK ONLY. Whitelisting all of
# RFC1918 is unsafe on cloud VMs behind a NAT/LB/tunnel and on shared VPCs.
# Add YOUR trusted management CIDRs below.

[DEFAULT]
# Example: ignoreip = 127.0.0.1/8 ::1 203.0.113.0/24
ignoreip = 127.0.0.1/8 ::1

findtime = 10m
bantime  = 1h
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w
maxretry = 5

backend  = systemd

# firewalld is the RHEL-family firewall backend.
banaction          = firewallcmd-rich-rules
banaction_allports = firewallcmd-rich-rules

[sshd]
enabled  = true
mode     = aggressive
port     = ssh
maxretry = 4

[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
bantime  = 1w
findtime = 1d
maxretry = 3
