# TWDxOSOptimisation — fail2ban jail.local (v2.0.0)
# https://github.com/TheWebDexterTech/TWDxOSOptimisation
#
# DEFAULT CHANGED in v2.0.0: ignoreip is now LOOPBACK ONLY.
# Whitelisting all of RFC1918 (10/8, 172.16/12, 192.168/16) is unsafe on
# cloud VMs behind a NAT / load-balancer / tunnel that presents a private
# source IP (it would trust the whole internet), and on shared VPCs (it
# trusts every lateral host). Add YOUR trusted management CIDRs below.

[DEFAULT]
# Add office / VPN / bastion CIDRs here — space-separated. Example:
#   ignoreip = 127.0.0.1/8 ::1 203.0.113.0/24 198.51.100.7
ignoreip = 127.0.0.1/8 ::1

# Window in which `maxretry` failures trigger a ban.
findtime = 10m

# Base ban duration (grows on repeat offenders — see bantime.increment).
bantime  = 1h

bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w

maxretry = 5

# systemd journal backend (Ubuntu 22.04+/Debian 12 default).
backend  = systemd

# nftables on modern Debian/Ubuntu; falls back to iptables if absent.
banaction          = nftables-multiport
banaction_allports = nftables-allports

[sshd]
enabled  = true
mode     = aggressive
port     = ssh
maxretry = 4

# Long-ban IPs that keep coming back after their first ban expires.
[recidive]
enabled  = true
logpath  = /var/log/fail2ban.log
bantime  = 1w
findtime = 1d
maxretry = 3
