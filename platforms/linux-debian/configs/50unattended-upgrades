// TWDxOSOptimisation — unattended-upgrades policy (v2.0.0)
// https://github.com/TheWebDexterTech/TWDxOSOptimisation
//
// DEFAULT CHANGED in v2.0.0: security pocket ONLY. Feature/-updates and
// DevRelease upgrades are no longer applied automatically — they carry
// regression risk that a hands-off *security* tool should not take on your
// behalf. Add "${distro_id}:${distro_codename}-updates" below if you want
// the old behaviour back.

Unattended-Upgrade::Allowed-Origins {
	"${distro_id}:${distro_codename}-security";
	"${distro_id}ESMApps:${distro_codename}-apps-security";
	"${distro_id}ESM:${distro_codename}-infra-security";
};

// Never auto-upgrade these (add held/pinned packages here).
Unattended-Upgrade::Package-Blacklist {
};

// Stay on the stable release; never chase a development pocket.
Unattended-Upgrade::DevRelease "false";

// Recover from a half-applied dpkg state on the next run.
Unattended-Upgrade::AutoFixInterruptedDpkg "true";

// One package at a time — keeps memory pressure low on small VMs.
Unattended-Upgrade::MinimalSteps "true";

// Reclaim disk from superseded kernels / now-unused dependencies.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Reboots are owned by auto-reboot.timer (respects REBOOT_TIME, Persistent).
// Do NOT let unattended-upgrades reboot too, or you get two mechanisms.
Unattended-Upgrade::Automatic-Reboot "false";

// Failure notifications are configured out-of-band in
// /etc/apt/apt.conf.d/52unattended-upgrades-twdxos when ADMIN_EMAIL is set.
Unattended-Upgrade::MailReport "on-change";

// Network resilience.
Acquire::Retries "3";

// Verbose journald output so log shippers can see failures.
Unattended-Upgrade::Verbose "true";

// Do not pause for AC power on VMs; skip metered links.
Unattended-Upgrade::OnlyOnACPower "false";
Unattended-Upgrade::Skip-Updates-On-Metered-Connections "true";
